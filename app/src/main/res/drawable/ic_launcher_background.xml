<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="@color/launcher_bg_end"
                android:startColor="@color/launcher_bg_start"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.3"
                android:centerY="0.25"
                android:endColor="#00000000"
                android:gradientRadius="60dp"
                android:startColor="#6D45C9"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
