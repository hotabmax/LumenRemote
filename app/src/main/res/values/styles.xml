<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Типографика -->
    <style name="TextAppearance.Lumen.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">30sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>

    <style name="TextAppearance.Lumen.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">21sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Lumen.Headline" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Lumen.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
    </style>

    <style name="TextAppearance.Lumen.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="TextAppearance.Lumen.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextAppearance.Lumen.Code" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">22sp</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Карточки -->
    <style name="Widget.Lumen.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="contentPadding">0dp</item>
    </style>

    <style name="Widget.Lumen.Card.Inner" parent="Widget.Lumen.Card">
        <item name="cardBackgroundColor">@color/surface_2</item>
        <item name="cardCornerRadius">@dimen/card_radius_s</item>
    </style>

    <!-- Кнопки -->
    <style name="Widget.Lumen.Button" parent="">
        <item name="android:layout_height">56dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Lumen.Button.Outline" parent="Widget.Lumen.Button">
        <item name="android:background">@drawable/bg_button_outline</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.Lumen.Button.Ghost" parent="Widget.Lumen.Button">
        <item name="android:background">@drawable/bg_button_ghost</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Widget.Lumen.IconButton" parent="">
        <item name="android:layout_width">@dimen/touch_min</item>
        <item name="android:layout_height">@dimen/touch_min</item>
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="Widget.Lumen.Tooltip" parent="Widget.Material3.Tooltip">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.Lumen.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">#268B5CFF</item>
        <item name="android:width">62dp</item>
        <item name="android:height">30dp</item>
    </style>

    <style name="Widget.Lumen.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconSize">24dp</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Lumen.NavIndicator</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.Lumen.NavActive</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.Lumen.NavInactive</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="TextAppearance.Lumen.NavActive" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.Lumen.NavInactive" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Поля ввода -->
    <style name="Widget.Lumen.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/surface_2</item>
        <item name="boxStrokeColor">@color/violet</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">18dp</item>
        <item name="boxCornerRadiusTopEnd">18dp</item>
        <item name="boxCornerRadiusBottomStart">18dp</item>
        <item name="boxCornerRadiusBottomEnd">18dp</item>
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
    </style>

    <style name="Widget.Lumen.EditText" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!-- Мелкие элементы -->
    <style name="Widget.Lumen.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/surface_2</item>
        <item name="chipStrokeColor">@color/stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="chipIconTint">@color/cyan</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.Lumen.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbTint">@color/switch_thumb</item>
        <item name="trackTint">@color/switch_track</item>
    </style>

</resources>
