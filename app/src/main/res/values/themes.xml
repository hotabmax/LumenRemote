<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.Lumen" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/violet</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/violet_deep</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>
        <item name="colorSecondary">@color/cyan</item>
        <item name="colorOnSecondary">@color/bg_deep</item>
        <item name="colorTertiary">@color/blue</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceVariant">@color/surface_2</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface_2</item>
        <item name="colorSurfaceContainerHighest">@color/surface_3</item>
        <item name="colorOutline">@color/stroke_strong</item>
        <item name="colorOutlineVariant">@color/stroke</item>
        <item name="colorError">@color/danger</item>
        <item name="colorOnError">@color/white</item>
        <item name="colorControlHighlight">#22FFFFFF</item>

        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@drawable/bg_app</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:navigationBarDividerColor" tools:targetApi="27">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>

        <item name="bottomSheetDialogTheme">@style/Theme.Lumen.BottomSheet</item>
        <item name="tooltipStyle">@style/Widget.Lumen.Tooltip</item>
    </style>

    <style name="Theme.Lumen" parent="Base.Theme.Lumen" />

    <style name="Theme.Lumen.Immersive" parent="Base.Theme.Lumen">
        <item name="android:windowBackground">@color/bg_deep</item>
        <item name="android:windowTranslucentStatus">false</item>
    </style>

    <style name="Theme.Lumen.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Lumen.BottomSheet</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Widget.Lumen.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/surface_2</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Lumen.Sheet</item>
    </style>

    <style name="ShapeAppearance.Lumen.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

</resources>
