# Keystore для подписи release-сборки Lumen Remote.
# Скопируйте в keystore.properties (файл в git не попадает) и подставьте свои значения.
#
# Создание ключа:
#   keytool -genkeypair -v -keystore lumen-release.jks \
#     -alias lumen -keyalg RSA -keysize 2048 -validity 10000 \
#     -dname "CN=Lumen Remote, O=Your Company, C=RU"
#
# Путь может быть абсолютным или относительным каталогу app/.

storeFile=/absolute/path/to/lumen-release.jks
storePassword=change-me
keyAlias=lumen
keyPassword=change-me

# В рабочем каталоге используется keystore/lumen-release.jks (в .gitignore).
# Для CI передавайте значения через секреты и генерируйте keystore.properties на шаге сборки.
