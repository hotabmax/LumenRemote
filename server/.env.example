# Lumen Relay — конфигурация production-окружения.
# Скопируйте в .env и заполните значения (файл в git не попадает).

# Порт и адрес прослушивания внутри контейнера/хоста
PORT=8080
HOST=0.0.0.0

# Домен для TLS-прокси Caddy (например relay.example.com)
RELAY_DOMAIN=relay.example.com

# Белый список Origin для WebSocket (через запятую).
# Пустое значение разрешает любые источники — не рекомендуется в продакшене.
ALLOWED_ORIGINS=https://relay.example.com

# Лимиты
MAX_ROOMS=5000
MAX_PAYLOAD_BYTES=8388608
ROOM_TTL_MS=43200000
HEARTBEAT_MS=30000
JOIN_WINDOW_MS=60000
JOIN_MAX_ATTEMPTS=10

# Уровень логов: debug | info | warn | error
LOG_LEVEL=info

# Доверять заголовку X-Forwarded-For (ставить 1 только за доверенным прокси)
TRUST_PROXY=1
